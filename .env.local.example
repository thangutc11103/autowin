# .env.local.example
# Copy this file to .env.local and fill in your actual values

# ============================================
# Redis Configuration
# ============================================

# Local Development (Docker or Redis Server)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Alternative: Redis Cloud (Uncomment to use)
# Get credentials from: https://redis.com/cloud/
# REDIS_HOST=redis-cloud-xxxx.c123.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your_password_here
# REDIS_DB=0

# ============================================
# Database Configuration - PostgreSQL
# ============================================
#
# Local PostgreSQL Configuration
# Username: postgres
# Password: (your password)
# Database: find_app
# Host: localhost
#
DATABASE_URL=

# ============================================
# Decodo Scraper API Configuration
# ============================================
#
# Get token from: https://scraper-api.decodo.com
# Format: Basic Auth Token (base64 encoded)
# Example: base64_username_password_from_decodo
#
DECODO_TOKEN=

# ============================================
# Instagram Scraper Session (Optional)
# ============================================
#
# Instagram hashtag pages often require a logged-in browser session.
# Paste a Cookie request header from an Instagram web session when needed.
#
# INSTAGRAM_COOKIES=<browser-cookie-string>

# ============================================
# Application Configuration (Optional)
# ============================================
#
NEXT_PUBLIC_API_URL=http://localhost:3000
LOG_LEVEL=debug
ENABLE_JOB_MONITORING=true
ENABLE_QUEUE_VISUALIZATION=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_before_deploying
DEFAULT_TENANT_ID=default

# ============================================
# Application Configuration
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: Logging
LOG_LEVEL=debug

# Optional: Feature Flags
ENABLE_JOB_MONITORING=true
ENABLE_QUEUE_VISUALIZATION=true

# ============================================
# OAuth Configuration
# ============================================
#
# TikTok Direct Post needs video.publish. Inbox upload/draft mode needs video.upload.
# After changing scopes, reconnect the TikTok account so the saved token includes them.
#
NEXT_PUBLIC_APP_URL=http://localhost:3000
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/accounts
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,video.publish
TIKTOK_PUBLISH_MODE=direct
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
